#!/usr/bin/env bash
# Toggle: float + pin a tile at a fixed size, or put it back.
width=${1:-1300} height=${2:-900}
active=$(hyprctl activewindow -j)
pinned=$(jq -r .pinned <<<"$active")
addr=$(jq -r .address <<<"$active")

if [[ $pinned == true ]]; then
  hyprctl -q --batch "dispatch pin address:$addr;" "dispatch togglefloating address:$addr;" "dispatch tagwindow -pop address:$addr;"
elif [[ -n $addr ]]; then
  hyprctl dispatch togglefloating address:$addr
  hyprctl dispatch resizeactive exact $width $height address:$addr
  hyprctl dispatch centerwindow address:$addr
  hyprctl -q --batch "dispatch pin address:$addr;" "dispatch alterzorder top address:$addr;" "dispatch tagwindow +pop address:$addr;"
fi
