#!/usr/bin/env bash
# Usage: dot-launch-webapp <url> — open URL as a chromium-style app window.
browser=$(xdg-settings get default-web-browser)
case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium-browser.desktop" ;;
esac

exec_cmd=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/run/current-system/sw,/etc/profiles/per-user/$USER}/share/applications/$browser 2>/dev/null | head -1)
exec setsid uwsm app -- "${exec_cmd:-chromium}" --app="$1" "${@:2}"
