#!/usr/bin/env bash
# Lock screen. DOT_LOCK_ONLY=true skips display-off.
if ! pidof hyprlock >/dev/null; then
  ( hyprlock; hyprctl dispatch dpms on ) &
fi
hyprctl switchxkblayout all 0 >/dev/null 2>&1

if [[ ${DOT_LOCK_ONLY:-false} != "true" ]]; then
  ( sleep 3; pidof hyprlock >/dev/null && hyprctl dispatch dpms off ) &
fi
